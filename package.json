{
  "name": "arbejdsglaede",
  "main": "expo-router/entry",
  "version": "0.0.0",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": "^22.23.1 || ^24.3.0 || >=26.0.0"
  },
  "scripts": {
    "android": "expo run:android",
    "build": "EAS_BUILD_NO_EXPO_GO_WARNING=true yarn run eas build",
    "check-formatting": "prettier --check .",
    "check-lint": "eslint --format unix --max-warnings 0",
    "check-types": "tsc",
    "check-unused": "knip",
    "eas": "sh -c 'EXPO_TOKEN=$(op read \"op://Private/Expo arbejdsglaede build/credential\") && export EXPO_TOKEN && exec npx eas-cli@latest \"$@\"' -- \"$@\"",
    "eas-build-pre-install": "corepack enable",
    "generate-icons": "node scripts/generateIcons.ts",
    "generate-smiley-assets": "node scripts/generateSmileyAssets.ts",
    "generate-typed-routes": "expo customize tsconfig.json",
    "ios": "expo run:ios",
    "ios-device": "expo run:ios --device",
    "start": "expo start",
    "submit": "yarn run eas submit",
    "update-preview": "yarn run eas update --channel preview --environment preview",
    "update-production": "yarn run eas update --channel production --environment production"
  },
  "dependencies": {
    "@e18e/eslint-plugin": "^0.8.1",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
