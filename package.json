    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "globals": "^17.14.0",
    "i18next": "^26.7.2",
    "knip": "^6.44.1",
    "mobx": "^7.1.5",
    "mobx-persist-store": "^1.1.8",
    "mobx-react-lite": "^5.1.2",
    "nativewind": "5.0.0-rc.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "19.3.0",
    "react-i18next": "^17.1.13",
