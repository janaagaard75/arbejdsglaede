    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "clsx": "^2.1.1",
    "eslint": "^10.14.0",
    "eslint-formatter-unix": "^9.0.1",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-de-morgan": "^2.3.0",
    "eslint-plugin-filename-export": "patch:eslint-plugin-filename-export@npm%3A2.0.0#~/.yarn/patches/eslint-plugin-filename-export-npm-2.0.0-47c320c279.patch",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.1.0",
    "expo": "^58.0.0",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.15",
