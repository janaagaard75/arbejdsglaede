    "generate-icons": "node scripts/generateIcons.ts",
    "generate-typed-routes": "expo customize tsconfig.json",
    "ios": "expo run:ios",
    "ios-device": "expo run:ios --device",
    "start": "expo start",
    "submit-ios": "pnpm run eas submit --platform ios"
  },
  "dependencies": {
